# Ollama runs locally; no API keys are required.
# In Docker, docker-compose.yml overrides this to http://ollama:11434.
OLLAMA_HOST=http://localhost:11434

# Model selection
LLM_MODEL=llama3.1
CLASSIFY_MODEL=
EMBED_MODEL=nomic-embed-text

# Persistence
CHECKPOINT_DB=data/checkpoints.sqlite

# Optional ChromaDB server connection (used in Docker); falls back to local persistent storage.
CHROMA_HOST=
CHROMA_PORT=8000

# PostgreSQL connection (Docker overrides PGHOST to 'db')
PGHOST=localhost
PGPORT=5432
PGDATABASE=support_agent
PGUSER=agent
PGPASSWORD=password

# Guardrails
MAX_INPUT_LENGTH=2000

# Logging
LOG_LEVEL=INFO

# FastAPI settings
API_RATE_LIMIT=10/minute
CORS_ORIGINS=*

# Streamlit frontend URL (only needed when running the UI separately)
API_URL=http://localhost:8000

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=dispatch-ai
