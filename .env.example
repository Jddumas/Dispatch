# LLM provider: ollama, groq, or openai
LLM_PROVIDER=ollama

# Model selection (provider-specific model names)
# Ollama: llama3.1, nomic-embed-text
# Groq: llama-3.1-8b-instant, mixtral-8x7b-32768
# OpenAI: gpt-4o-mini, text-embedding-3-small
LLM_MODEL=llama3.1
CLASSIFY_MODEL=

# Embedding provider: ollama, openai, or fastembed
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# API keys for hosted providers (only needed when LLM_PROVIDER or EMBED_PROVIDER is set to a cloud service)
GROQ_API_KEY=
OPENAI_API_KEY=

# Disable Groq SSL certificate verification (default: true). Only set to false if you are behind
# a TLS-intercepting proxy that causes certificate verify failures.
GROQ_VERIFY_SSL=true

# Ollama host (Docker overrides this to http://ollama:11434)
OLLAMA_HOST=http://localhost:11434

# Persistence
CHECKPOINT_DB=data/checkpoints.sqlite

# Optional ChromaDB server connection (used in Docker); falls back to local persistent storage.
CHROMA_HOST=
CHROMA_PORT=8000

# PostgreSQL connection (Docker overrides PGHOST to 'db')
PGHOST=localhost
PGPORT=5432
PGDATABASE=support_agent
PGUSER=agent
PGPASSWORD=password

# Guardrails
MAX_INPUT_LENGTH=2000

# Logging
LOG_LEVEL=INFO

# FastAPI settings
API_RATE_LIMIT=10/minute
CORS_ORIGINS=*

# Streamlit frontend URL (only needed when running the UI separately)
API_URL=http://localhost:8000

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=otto
